# Внешний вид, который разворачивается на новой машине.
# Любую переменную можно перебить окружением:
#   RU_THEME=gruvbox ./install.sh theme

# Слаг темы — имя каталога в /usr/share/omarchy/themes или
# ~/.config/omarchy/themes. omarchy theme set принимает и "Tokyo Night",
# и tokyo-night: он сам приводит имя к нижнему регистру и дефисам.
RU_THEME="tokyo-night"

# Git-репозиторий темы. Нужен, только если тема не стоковая: модуль поставит
# её через omarchy theme install, когда каталога темы на машине не окажется.
RU_THEME_REPO=""

# Имя файла фона внутри backgrounds/ выбранной темы. Пусто — оставить тот,
# который Omarchy выберет сама при установке темы.
RU_BACKGROUND="0-winding-road.jpg"

# Моноширинный шрифт системы. Пусто — не трогать.
RU_FONT="JetBrainsMono Nerd Font"
