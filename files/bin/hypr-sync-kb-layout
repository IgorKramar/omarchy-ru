#!/usr/bin/env python3
"""Keep the xkb layout in sync across every physical keyboard.

Hyprland switches xkb groups per device, so grp:alt_shift_toggle only moves the
keyboard the combo was pressed on. This listens on Hyprland's event socket and
mirrors each switch onto the other keyboards that carry the same layout list.
"""

import json
import os
import socket
import subprocess
import sys

VIRTUAL_PREFIX = "hl-virtual-keyboard"


def event_socket():
    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")

    if signature:
        return f"{runtime}/hypr/{signature}/.socket2.sock"

    # uwsm may start us before the signature lands in the environment.
    base = f"{runtime}/hypr"
    candidates = [
        os.path.join(base, name, ".socket2.sock")
        for name in os.listdir(base)
        if os.path.exists(os.path.join(base, name, ".socket2.sock"))
    ]
    if not candidates:
        sys.exit("no Hyprland event socket found")
    return max(candidates, key=os.path.getmtime)


def keyboards():
    out = subprocess.run(
        ["hyprctl", "-j", "devices"], capture_output=True, text=True, check=True
    ).stdout
    return json.loads(out)["keyboards"]


def switchable(keyboard):
    # The lighting/hotkey HID interfaces and fcitx5's injector answer to
    # switchxkblayout too, but nobody types on them.
    return "," in keyboard["layout"] and not keyboard["name"].startswith(VIRTUAL_PREFIX)


def sync(source_name):
    devices = keyboards()
    source = next((k for k in devices if k["name"] == source_name), None)
    if source is None or not switchable(source):
        return

    index = source["active_layout_index"]
    for keyboard in devices:
        if keyboard["name"] == source_name or not switchable(keyboard):
            continue
        # Skipping the ones already in place stops the events our own switches
        # emit from bouncing back and forth.
        if keyboard["active_layout_index"] != index:
            subprocess.run(
                ["hyprctl", "switchxkblayout", keyboard["name"], str(index)],
                stdout=subprocess.DEVNULL,
            )


def main():
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    client.connect(event_socket())

    buffer = b""
    while True:
        chunk = client.recv(4096)
        if not chunk:
            break
        buffer += chunk
        *lines, buffer = buffer.split(b"\n")

        for line in lines:
            name, _, payload = line.decode("utf-8", "replace").partition(">>")
            if name == "activelayout":
                sync(payload.split(",")[0])


if __name__ == "__main__":
    main()
